---
/** Selector de periodo: botones de opción nativos (se manejan con flechas y sin JavaScript). */
import { RANGO_POR_DEFECTO, RANGOS } from '../grafico/rango.ts';
---

<fieldset class="rangos">
  <legend class="sr-only">Periodo del gráfico</legend>
  {
    RANGOS.map((rango) => (
      <span class="rangos__opcion">
        <input
          class="sr-only"
          type="radio"
          name="rango"
          id={`rango-${rango.clave}`}
          value={rango.clave}
          checked={rango.clave === RANGO_POR_DEFECTO}
        />
        <label for={`rango-${rango.clave}`}>{rango.etiqueta}</label>
      </span>
    ))
  }
</fieldset>

<style>
  .rangos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.25rem;
    margin: 0.75rem 0 0;
    padding: 0.25rem;
    border: 1px solid var(--linea);
    border-radius: 999px;
    background: var(--superficie);
  }

  .rangos__opcion {
    display: flex;
  }

  label {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tactil);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--tinta-suave);
    cursor: pointer;
    user-select: none;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  label:hover {
    color: var(--tinta);
  }

  input:checked + label {
    background: var(--tinta);
    color: var(--fondo);
  }

  input:focus-visible + label {
    outline: 3px solid var(--acento);
    outline-offset: 2px;
  }
</style>
