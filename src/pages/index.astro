---
import Base from '../layouts/Base.astro';
import Atribucion from '../componentes/Atribucion.astro';
import NavCategorias from '../componentes/NavCategorias.astro';
import SeccionCategoria from '../componentes/SeccionCategoria.astro';
import { agruparPorCategoria } from '../datos/categorias.ts';
import { cargarResumen, cargarSerie } from '../datos/cargar.ts';
import { unirRuta } from '../datos/rutas.ts';
import { textoResumenSemana } from '../formato/categorias.ts';
import { descripcionPortada, tituloPortada } from '../formato/compartir.ts';
import { etiquetaSemanaConFechas, fechaAMs, formatearRango } from '../formato/fechas.ts';
import { puntosDeSerie } from '../grafico/serie.ts';

const resumen = cargarResumen();
const { ultimaSemana, productos } = resumen;
const referencia = fechaAMs(ultimaSemana.lunes);
const puntosDe = (slug: string) => puntosDeSerie(cargarSerie(slug).puntos);
const grupos = agruparPorCategoria(resumen);
const conPrecio = productos.filter((producto) => producto.cotizaEstaSemana).length;
const resumenSemana = textoResumenSemana(productos.length, conPrecio, `semana ${ultimaSemana.semana}`);
const ordenesIniciales = grupos.map((_, i) => grupos.slice(0, i).reduce((suma, grupo) => suma + grupo.total, 0));
---

<Base titulo={tituloPortada(resumen)} descripcion={descripcionPortada(resumen)}>
  <section class="portada" aria-labelledby="titulo-lista">
    <p class="antetitulo">Precio semanal en origen</p>
    <h1 id="titulo-lista">Semana {ultimaSemana.semana}</h1>
    <p class="fechas cifra">
      {formatearRango(ultimaSemana.lunes, ultimaSemana.domingo)} · Comunitat Valenciana
    </p>
    <p class="resumen-semana">
      <strong class="cifra">{resumenSemana}</strong>
      {
        conPrecio < productos.length && (
          <span>
            {' '}Los demás, casi siempre fuera de campaña, van al final de su grupo con su último precio.
          </span>
        )
      }
    </p>

    <NavCategorias grupos={grupos} />

    {
      grupos.map((grupo, i) => (
        <SeccionCategoria
          grupo={grupo}
          semana={ultimaSemana.semana}
          referencia={referencia}
          puntosDe={puntosDe}
          ordenInicial={ordenesIniciales[i] ?? 0}
        />
      ))
    }

    <div class="notas">
      <p class="pequeno">
        Euros por kilo, sin IVA. El precio medio es el punto medio de la horquilla mínimo–máximo. La variación es un cálculo de esta web frente a
        la cotización anterior. La línea de cada producto es su precio medio del último año.{' '}<a href={unirRuta(import.meta.env.BASE_URL, 'sobre-los-datos/')}>Sobre los datos</a>
      </p>
      <Atribucion fuente={resumen.fuente} semana={etiquetaSemanaConFechas(ultimaSemana, ultimaSemana.lunes)} />
    </div>
  </section>
</Base>

<style>
  .portada {
    padding-top: 1.5rem;
  }

  .antetitulo {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  h1 {
    font-size: 2.25rem;
  }

  .fechas {
    margin: 0.35rem 0 0.75rem;
    color: var(--tinta-suave);
  }

  .resumen-semana {
    margin: 0 0 1rem;
    max-width: 36rem;
    font-size: 0.9375rem;
    color: var(--tinta-suave);
  }

  .resumen-semana strong {
    font-weight: 600;
    color: var(--tinta);
  }

  .notas {
    margin-top: 2rem;
    display: grid;
    gap: 0.5rem;
  }

  .notas p {
    margin: 0;
  }

  @media (min-width: 40rem) {
    h1 {
      font-size: 2.75rem;
    }
  }
</style>
